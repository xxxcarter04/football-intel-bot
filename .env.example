# Deploy as a paid Render background worker (always on, no spin-down).
# SELF_PING_URL below is only for the legacy free web service and is not used
# by the worker.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# API-Football (RapidAPI). Free trial available at https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# Optional fallback provider (free tier: https://www.football-data.org/client/register)
FOOTBALL_DATA_TOKEN=

# Data window: history used for model fitting (seasons back from current)
HISTORY_SEASONS=3

# Cache TTL in hours
CACHE_TTL_HOURS=6

# Comma-separated league IDs (API-Football IDs). Defaults to top European + UCL.
LEAGUE_IDS=39,140,135,78,61,2

# Timezone and time for daily digest (only sent to allowed users)
TIMEZONE=UTC
DIGEST_TIME=09:00

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=

# DEPRECATED for the paid worker. Only used by the old free Render web service,
# which slept after 15 idle minutes. Leave empty on the worker.
SELF_PING_URL=
